{
  "manifest_version": 3,
  "name": "Plataforma SE2 - Otimizador",
  "version": "3.0",
  "description": "Melhorias de qualidade de vida e um guia para ajudar nas análises",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://plataforma-se2/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
