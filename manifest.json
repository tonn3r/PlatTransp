{
  "manifest_version": 3,
  "name": "Plataforma SE2 - Otimizador",
  "version": "3.1",
  "description": "Melhorias de qualidade de vida e um guia para ajudar nas análises",
  "permissions": ["storage"],
  "config_ambiente": "teste_versao",
  "content_scripts": [
    {
      "matches": ["http://plataforma-se2/administrador/modulos/transporte_escolar/*"],
      "js": [
        "escolas_db.js",
        "ruas.js",
        "encaminhamentos.js",
        "funcs_geolocalizacao.js",
        "funcs_assistente.js",
	      "funcs_ficha.js",
	      "funcs_pesquisa.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
