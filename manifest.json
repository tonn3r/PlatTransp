{
  "manifest_version": 3,
  "name": "Plataforma SE2 - Otimizador",
  "version": "4.0",
  "description": "Melhorias de qualidade de vida e um guia para ajudar nas análises",
  "permissions": ["storage"],
  "config_ambiente": "teste",
  "update_url": "https://raw.githubusercontent.com/tonn3r/PlatTransp/teste/version.xml",
  "content_scripts": [
    {
      "matches": ["http://plataforma-se2/*"],
      "js": [
        "escolas_db.js",
        "ruas.js",
        "encaminhamentos.js",
        "funcs_ficha.js",
        "funcs_pesquisa.js",
        "funcs_geolocalizacao.js",
        "funcs_assistente.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}